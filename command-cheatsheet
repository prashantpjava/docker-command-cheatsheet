# create alias for any command 

echo "alias d='docker'" >> ~./bashrc
source ~./bashrc

# get docker images

docker images
docker image list
docker image ls

#docker list images including intermediate images

docker images -a

# show images id

docker images -q


# remove images

docker rmi <image_id>

# show inspect of an image
docker inspect <image_id>

# list all containers
docker ps -a


# list all running containers

docker ps
docker container list

# show details about a container

docker inspect <container_id>

#tag an image
docker tag <image_id> <new_image_name>:version

#push an image to docker hub (Frist tag the image with your docker hub username and then push it)
docker push <image_name>:version